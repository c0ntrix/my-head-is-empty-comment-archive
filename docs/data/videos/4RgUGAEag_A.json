        "channelId": "UCSFJNPUydjdiho5RAbSk0qQ",
        "profileImageUrl": "https://yt3.ggpht.com/-S0B-GZ4ZBB1J0GtbNIy0c-mV-l0uzf_pwsHWCOzoV8xW13H9rgnjdS5wYc3VxpMeMD_7_zX_w=s88-c-k-c0x00ffffff-no-rj",
        "avatar": null,
        "isUploader": false,
        "isVerified": false
      },
      "text": "When people see me, they see a man that is smiling big. Someone who is “happy”… but I never am. I tried to hide it… but I can’t anymore. I have bags under my eyes and I look as though I am going to fall to the floor at any second. When I tried to open up to someone I was sent away. No one cares about the saddened. They only want them isolated away from the happy…",
      "likeCount": 8,
      "publishedAt": "2024-08-06T00:00:00.000Z",
      "relativeTimeAtArchive": "2 years ago",
      "updatedAt": null,
      "viewerRating": null,
      "moderationStatus": null,
      "isPinned": false,
      "isFavorited": false,
      "archiveOrder": 8,
      "canReply": null,
      "isPublic": true,
      "totalReplyCountAtArchive": 3,
      "replies": [
        {

# Create a key after enabling YouTube Data API v3 in Google Cloud Console.
YOUTUBE_API_KEY=replace_me

# Optional delay between web-fallback requests in seconds. Higher is gentler but slower.
YOUTUBE_WEB_REQUEST_DELAY=0.25

# Retry incomplete YouTube comment/reply pages before skipping them.
YOUTUBE_COMMENT_RETRIES=12
YOUTUBE_COMMENT_RETRY_SLEEP=1

# Optional: use a logged-in Firefox session if anonymous reply pages remain unavailable.
# Direct Chrome/Edge cookie extraction generally fails on Windows due to App-Bound encryption.
# YOUTUBE_COOKIES_FROM_BROWSER=firefox

# Alternatively, export only YouTube cookies in Netscape format into this ignored directory.
# YOUTUBE_COOKIES_FILE=.cache/youtube-cookies.txt
